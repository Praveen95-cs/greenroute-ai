# =============================================================================
# GreenRoute AI — Environment Configuration
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# PostgreSQL (Docker Compose)
POSTGRES_USER=greenroute
POSTGRES_PASSWORD=greenroute_dev_password
POSTGRES_DB=greenroute
POSTGRES_PORT=5433
DATABASE_URL=postgresql://greenroute:greenroute_dev_password@localhost:5433/greenroute?schema=public

# Backend API
BACKEND_PORT=3001
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# AI Service
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://localhost:8000
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Frontend
VITE_API_URL=http://localhost:3001
VITE_APP_NAME=GreenRoute AI

# Live routing (OSRM + Nominatim). Use `demo` for offline tests.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
